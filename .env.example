# Supabase → Project Settings → Database → Connect → URI
# Prefer the Session pooler or Direct connection string (not Transaction/pgbouncer) so Prisma can push schema.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
ADMIN_EMAIL="admin@syncify.com"
ADMIN_PASSWORD="change-me-on-first-deploy"
NEXTAUTH_URL="http://localhost:3000"
